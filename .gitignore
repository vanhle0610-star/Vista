# ==============================================================================
# VISTA .gitignore
# ==============================================================================

# 1. Environment secrets (Tuyệt đối không commit file chứa credentials)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
backend/run-backend.bat
mobile/.env
mobile/.env.*
!mobile/.env.example
admin/.env
admin/.env.*
!admin/.env.example

# 2. Dependencies (Tuyệt đối không đẩy node_modules lên Git)
node_modules/
**/node_modules/

# 3. Build & Cache Artifacts
.next/
**/.next/
.expo/
**/.expo/
dist/
**/dist/
build/
**/build/
.gradle/
**/.gradle/
out/
**/out/

# 4. Logs & Temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. IDE & OS files
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
