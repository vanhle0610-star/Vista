# ==============================================================================
# VISTA .gitignore
# ==============================================================================

# 1. Environment secrets (Tuyệt đối không commit file chứa credentials)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
backend/run-backend.bat
mobile/.env
mobile/.env.*
!mobile/.env.example
admin/.env
admin/.env.*
!admin/.env.example
web/.env
web/.env.*
!web/.env.example

# 2. Dependencies (Tuyệt đối không đẩy node_modules lên Git)
node_modules/
**/node_modules/

# 3. Build & Cache Artifacts
.next/
**/.next/
.expo/
**/.expo/
dist/
**/dist/
build/
**/build/
.gradle/
**/.gradle/
backend/.gradle-local/
out/
**/out/

# 4. Logs & Temp
*.log
*.zip
npm-debug.log*
yarn-debug.log*
yarn-error.log*
Vietnam_dia_diem_*.csv

# 5. IDE & OS files
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# 6. Personal & Local Workspace Files
CV_Vanh/
*.docx
*.doc
*.xlsx
Vietnam_300_dia_diem*
outputs/
work/
test_screenshot.bat
stitch_vista_travel_expense_app_ui/

# 7. Python Artifacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
scratch/
**/scratch/
ai-service/.env
ai-service/.env.*
!ai-service/.env.example

artifacts/tv5-mobile/*.apk
