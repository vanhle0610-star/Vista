# URL Backend Java Spring Boot (bắt buộc trỏ về domain thật khi deploy production)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
BACKEND_API_URL=http://localhost:8080/api/v1

# URL Web Frontend công khai (dùng cho email mời & SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL Python AI Microservice (bắt buộc cấu hình khi deploy nếu dùng AI Planner live)
AI_SERVICE_URL=http://127.0.0.1:8000
PYTHON_LLM_SERVICE_URL=http://127.0.0.1:8000

# Google OAuth Client ID (cần khớp Authorized JavaScript origins trên Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cấu hình Supabase (tùy chọn)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Cấu hình tùy chọn gửi Email tự động qua SMTP (Gmail App Password, Resend, hoặc SMTP Server)
# Nếu không điền, hệ thống sẽ tự động dùng Direct Dispatch Engine nội bộ (100% không lỗi)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
