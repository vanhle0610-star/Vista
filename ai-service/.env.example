# VISTA AI Python LLM Microservice Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERNAL_TOKEN=REPLACE_ME
DEV=0

# LLM API Provider (openai-compatible, claude, or gemini)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://fulldichvu.com/call-api/v1
LLM_API_KEY=REPLACE_ME
LLM_MODEL=fulldichvu/opus-4.8

# Path to destination database CSV for grounding
DESTINATIONS_DATA_PATH=../backend/src/main/resources/db/seed/demo_destinations_seed.csv
