        "type": "object",
        "required": [
          "body",
          "version"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
