          },
          "destinationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "uploadIds": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
