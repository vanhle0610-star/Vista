  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Author": {
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Media": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "Post": {
        "type": "object",
        "required": [
          "id",
          "author",
          "body",
          "version",
          "createdAt",
          "updatedAt",
          "media",
          "commentCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "destinationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          },
          "feeling": {
            "$ref": "#/components/schemas/Feeling"
          },
          "commentCount": {
            "type": "integer",
            "minimum": 0
          },
          "destination": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CommunityPlace"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PostCreate": {
        "type": "object",
        "required": [
          "body",
          "clientRequestId"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "clientRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "uploadIds": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "feeling": {
            "$ref": "#/components/schemas/Feeling"
          }
        }
      },
      "PostUpdate": {
        "type": "object",
        "required": [
          "body",
          "version"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "destinationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Omit to preserve the current destination; null removes it. Non-null IDs must be PUBLISHED."
          },
          "feeling": {
            "$ref": "#/components/schemas/Feeling",
            "description": "Omit to preserve the current feeling; null removes it."
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "postId",
          "author",
          "body",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "postId": {
            "type": "string",
            "format": "uuid"
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "rootId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "replyToId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "replyToAuthor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Author"
              },
              {
                "type": "null"
              }
            ]
          },
          "replyCount": {
            "type": "integer",
            "minimum": 0
          },
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "CommentWrite": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "replyToId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "clientRequestId": {
            "type": "string",
            "format": "uuid",
            "description": "Retain the same ID and payload across network retries. Optional for legacy clients."
          }
        },
        "description": "New clients always send clientRequestId and retain it across retries. Legacy root-only writes may omit it. Replies require it.",
        "allOf": [
          {
            "if": {
              "required": [
                "replyToId"
              ],
              "properties": {
                "replyToId": {
                  "type": "string"
                }
              }
            },
            "then": {
              "required": [
                "clientRequestId"
              ],
              "properties": {
                "clientRequestId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        ]
      },
      "CommentUpdate": {
        "type": "object",
        "required": [
          "body",
          "version"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Upload": {
        "type": "object",
        "required": [
          "id",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PostPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CommentPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "commentCount": {
            "type": "integer",
            "minimum": 0,
            "description": "All visible, nondeleted roots plus replies for this post, independent of pagination."
          }
        }
      },
      "Feeling": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          null,
          "HAPPY",
          "DELIGHTED",
          "EXCITED",
          "RELAXED",
          "GRATEFUL",
          "CONFIDENT",
          "SAD",
          "TIRED"
        ]
      },
      "CommunityPlace": {
        "type": "object",
        "required": [
          "id",
          "name",
          "area"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "area": {
            "type": [
              "string",
              "null"
            ]
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
