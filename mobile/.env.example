# =============================================================================
# VISTA MOBILE APPLICATION - ENVIRONMENT CONFIGURATION
# =============================================================================

# API Base URL hướng dẫn cấu hình theo môi trường:
# - Web (npm run web) & iOS Simulator:
#   EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# - Android Emulator (máy ảo kết nối về máy host):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
# - Thiết bị thật (Expo Go qua WiFi nội bộ LAN):
#   EXPO_PUBLIC_API_URL=http://192.168.1.xxx:8080/api/v1

EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_USE_MOCK_AUTH=false

# Cấu hình Google OAuth Client ID (tùy chọn khi bật Google Sign-in):
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
