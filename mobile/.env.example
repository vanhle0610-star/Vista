# Cấu hình kết nối Backend Spring Boot cho Mobile VISTA
# Backend mặc định chạy trên cổng 8081 (server.port: 8081)
#
# Đối với Android Emulator: http://10.0.2.2:8081/api/v1
# Đối với Web / iOS Simulator: http://localhost:8081/api/v1
# Đối với Thiết bị thật qua Wi-Fi LAN: http://<IP_LAN_CUA_MAY_TINH>:8081/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8081/api/v1
EXPO_PUBLIC_USE_MOCK_AUTH=false
